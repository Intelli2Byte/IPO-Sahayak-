# ==========================================
# 1. HIDE NON-CODE & TEMPORARY FILES
# ==========================================
# Removes PDFs, logs, spreadsheets, and charts from bloating the bar
*.pdf linguist-vendored
*.xls linguist-vendored
*.xlsx linguist-vendored
*.json linguist-vendored
*.md linguist-vendored
*.png linguist-vendored
*.jpeg linguist-vendored
*.jpg linguist-vendored

# ==========================================
# 2. OPTIMIZE FOR PROPER MERN (TypeScript/JavaScript)
# ==========================================
# Ensure your Next.js and frontend components stand out
*.tsx linguist-language=TypeScript
*.ts linguist-language=TypeScript
*.jsx linguist-language=JavaScript
*.js linguist-language=JavaScript

# Hide global CSS stylesheets so 'CSS' doesn't steal percentage from your MERN code
*.css linguist-documentation

# ==========================================
# 3. FORCE MAXIMUM PYTHON VISIBILITY
# ==========================================
# Mark all Python and AI engine scripts as primary codebase languages
*.py linguist-language=Python

# If you have specific background python files or data scripts, force them to show up
docling_parser_fixed.py linguist-language=Python


# 1. Force GitHub to calculate specific folders as pure Python
src/components/Wizard/* linguist-detectable=false
src/components/Dashboard/* linguist-detectable=false

# 2. Artificially expand your python files visibility
docling_parser_fixed.py linguist-detectable=true
